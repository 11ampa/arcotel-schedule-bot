# токен вашего телеграм-бота от @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# время кэширования расписания в секундах (по умолчанию 15 минут)
CACHE_TTL=900

# часовой пояс (по умолчанию московское время)
TIMEZONE=Europe/Moscow

# опциональный прокси для запросов к сайту расписания (если бот за пределами рф)
# SCHEDULE_PROXY=socks5://127.0.0.1:1080
